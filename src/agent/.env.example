FOUNDRY_PROJECT_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-6.1-sol"
SEARCH_ENDPOINT="https://<search>.search.windows.net"
KNOWLEDGE_BASE_NAME="personal-kb"
KNOWLEDGE_SOURCE_NAME="content-blob-ks"
TOPIC_KNOWLEDGE_BASE_NAME=""
TOPIC_KNOWLEDGE_SOURCE_NAME=""
COSMOS_ENDPOINT="https://<cosmos>.documents.azure.com:443/"
COSMOS_DATABASE="personal-agent"
STORAGE_ACCOUNT_URL="https://<storage>.blob.core.windows.net/"
ARTIFACTS_CONTAINER="artifacts"
CONTENT_CONTAINER="content"
# REPORT_LINK_HOURS=24   # 0 disables read-only SAS links for reports
# WEB_SEARCH_ENABLED=true
# Dedicated deployment for the web research sub-agent; empty runs web search on the main model.
WEB_SEARCH_MODEL_DEPLOYMENT_NAME="gpt-5.4-mini-search"
# gpt-image deployment for illustrations (only on explicit requests like 「絵にして」); empty disables them.
IMAGE_MODEL_DEPLOYMENT_NAME="gpt-image-2"
